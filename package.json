{
  "name": "kproj",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api run build:api",
    "build": "pnpm run build:web && pnpm run build:api",
    "package:all": "pnpm --filter api run package:api && pnpm --filter api run package:migrate && pnpm --filter api run package:presignup && pnpm --filter api run package:validate",
    "lint:web": "pnpm --filter web lint",
    "db:generate": "pnpm --filter db generate",
    "db:migrate": "pnpm --filter db migrate",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:api": "pnpm --filter api test"
  }
}
